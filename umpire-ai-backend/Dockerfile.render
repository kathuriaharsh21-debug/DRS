FROM python:3.11-slim

# System dependencies for OpenCV headless
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install lightweight dependencies (no PyTorch/ultralytics)
COPY requirements-render.txt requirements-render.txt
RUN pip install --no-cache-dir -r requirements-render.txt

# Copy application code
COPY . .

# Create storage directories
RUN mkdir -p /app/uploads /app/output

# Force classical detection tier (no YOLO on this deployment)
ENV DETECTION_TIER=classical
ENV TRACKING_TIER=classical
ENV USE_UKF=false

EXPOSE 8000

# Run with uvicorn
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
