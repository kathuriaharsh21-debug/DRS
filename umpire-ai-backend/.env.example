# ======================================================================
# Umpire AI Backend — Environment Variables (v2)
# ======================================================================
# Copy this file to .env and fill in values for your deployment.
# cp .env.example .env

# ---- Application ----
DEBUG=true
APP_NAME=Umpire AI Backend
APP_VERSION=2.0.0

# ---- Storage ----
UPLOAD_DIR=./uploads
OUTPUT_DIR=./output
MAX_VIDEO_SIZE=524288000

# ---- Detection (v2 Hybrid) ----
# "auto" = try YOLO first, fall back to HSV
# "yolo"  = YOLOv11 only (fails if no GPU/model)
# "classical" = HSV + MOG2 only (CPU-friendly)
DETECTION_TIER=auto

# YOLO model (place .pt file in project root or set full path)
YOLO_MODEL_PATH=yolo11s_cricket_ball.pt
YOLO_CONFIDENCE=0.35
YOLO_IOU_THRESHOLD=0.45
YOLO_IMGSZ=1280
YOLO_DEVICE=          # "" = auto, "0" = GPU, "cpu" = CPU

# Classical fallback
BALL_TYPE=red          # red, white, or pink
BALL_MIN_RADIUS=3
BALL_MAX_RADIUS=25

# ---- Tracking (v2 Hybrid) ----
# "auto" = try BoT-SORT first, fall back to Hungarian
# "botsort" = BoT-SORT only
# "classical" = Hungarian algorithm only
TRACKING_TIER=auto
TRACKER_MAX_DISTANCE=120.0
TRACKER_MAX_MISSING_FRAMES=15

# ---- Trajectory (v2 UKF) ----
# true  = Unscented Kalman Filter (nonlinear physics)
# false = Linear Kalman Filter (simpler, faster)
USE_UKF=true
UKF_ALPHA=0.1
UKF_BETA=2.0
UKF_PROCESS_NOISE=0.5

# ---- Physics Model ----
GRAVITY=9.81
AIR_DRAG_COEFF=0.002
MAGNUS_COEFF=0.001
RESTITUTION=0.65
SURFACE_FRICTION=0.4

# ---- Video Processing ----
FPS_TARGET=30
FRAME_SKIP=2

# ---- CORS (for production, set to your frontend domain) ----
# CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
